

// Vertex shader
const vertexShaderSource = `
attribute vec3 vertex;
attribute vec3 normal;
attribute vec4 tangent;
attribute vec2 tex;

uniform mat4 ModelViewProjectionMatrix;
uniform mat4 ModelViewMatrix;
uniform mat4 NormalMatrix;

varying vec3 vPosition;
varying vec3 vNormal;
varying vec3 vTangent;
varying float vHandedness;
varying vec2 vTexCoord;

void main() {
    vPosition   = (ModelViewMatrix * vec4(vertex, 1.0)).xyz;
    vNormal     = (NormalMatrix * vec4(normal, 0.0)).xyz;
    vTangent    = (ModelViewMatrix * vec4(tangent.xyz, 0.0)).xyz;
    vHandedness = tangent.w;
    vTexCoord   = tex;

    gl_Position = ModelViewProjectionMatrix * vec4(vertex, 1.0);
}`;


// Fragment shader
const fragmentShaderSource = `
#ifdef GL_FRAGMENT_PRECISION_HIGH
   precision highp float;
#else
   precision mediump float;
#endif

uniform sampler2D iTMU0;
uniform sampler2D iTMU1;
uniform sampler2D iTMU2;

uniform vec3 lightPosition;

varying vec3 vPosition;
varying vec3 vNormal;
varying vec3 vTangent;
varying float vHandedness;
varying vec2 vTexCoord;

void main() {
    const vec3  lightColor = vec3(1.0, 1.0, 1.0);
    const float ambient    = 0.15;
    const float shininess  = 32.0;

    vec3 N = normalize(vNormal);
    vec3 T = normalize(vTangent - dot(vTangent, N) * N);
    vec3 B = cross(N, T) * vHandedness;
    mat3 TBN = mat3(T, B, N);

    vec3 texNormal = texture2D(iTMU2, vTexCoord).rgb * 2.0 - 1.0;
    vec3 n = normalize(TBN * texNormal);

    vec3 L = normalize(lightPosition - vPosition);
    vec3 V = vec3(0.0, 0.0, 1.0);

    vec3  diffuseTex  = texture2D(iTMU0, vTexCoord).rgb;
    float specularTex = texture2D(iTMU1, vTexCoord).r;

    float lambert = max(dot(n, L), 0.0);

    float specular = 0.0;
    if (lambert > 0.0) {
        vec3 R = reflect(-L, n);
        specular = pow(max(dot(R, V), 0.0), shininess);
    }

    vec3 color = diffuseTex * ambient
               + diffuseTex * lambert * lightColor
               + specularTex * specular * lightColor;

    gl_FragColor = vec4(color, 1.0);
}`;


// Light vertex shader
const lightVertexShaderSource = `
attribute vec3 vertex;
uniform mat4 ModelViewProjectionMatrix;

void main() {
    gl_Position  = ModelViewProjectionMatrix * vec4(vertex, 1.0);
    gl_PointSize = 12.0;
}`;


// Light fragment shader
const lightFragmentShaderSource = `
precision mediump float;

void main() {
    vec2 d = gl_PointCoord - vec2(0.5);
    if (dot(d, d) > 0.25) discard;
    gl_FragColor = vec4(1.0, 1.0, 1.0, 1.0);
}`;
